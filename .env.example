# ─────────────────────────────────────────────────────────────
# Kolabo — environment variables
# Copy this file to .env.local for local dev, and add the same
# keys in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# --- Clerk (Authentication) ---
# https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs (defaults shown, override only if you change routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Clerk webhook signing secret (Dashboard → Webhooks → your endpoint)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase (Database) ---
# https://supabase.com/dashboard → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx
# Service role key — server-only, NEVER expose to the client/browser
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# --- Stripe (Billing) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# https://dashboard.stripe.com/webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Create this in Stripe → Product catalog → Add product → recurring monthly price
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# --- App ---
# Full public URL of the deployed site (no trailing slash). Used for Stripe
# checkout success/cancel redirects and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
